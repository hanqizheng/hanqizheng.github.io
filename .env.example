NEXT_PUBLIC_SITE_URL=https://hanqizheng.vercel.app

# Optional. Use "postgres" for a local Docker database, or leave empty to use Supabase
# when SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are present.
BLOG_DATABASE_PROVIDER=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BLOG_WRITE_TOKEN=replace-with-a-long-random-token

# Optional. Used by local Docker Postgres, or when running SQL migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
