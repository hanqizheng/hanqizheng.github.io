{
  "name": "handler-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:local:up": "docker compose up -d db",
    "db:local:down": "docker compose down",
    "db:migrate": "node scripts/run-migration.mjs",
    "vercel:build": "node scripts/vercel-build.mjs",
    "sync:posts": "node scripts/sync-posts.mjs",
    "validate:content": "node scripts/validate-content.mjs && node scripts/validate-markdown.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^1.27.0",
    "next": "^15.0.3",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.2",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "typescript": "^5.7.2"
  }
}
